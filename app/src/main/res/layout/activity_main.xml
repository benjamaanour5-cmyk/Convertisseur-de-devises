<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond_clair">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideZone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.45" />

    <View
        android:id="@+id/fondConversion"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/turquoise"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/guideZone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvTitre"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="14dp"
        android:paddingBottom="12dp"
        android:text="@string/titre"
        android:textColor="@color/blanc"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Spinner
        android:id="@+id/spDeviseSource"
        android:layout_width="100dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:backgroundTint="@color/blanc"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitre" />

    <TextView
        android:id="@+id/tvMontant"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical|end"
        android:maxLines="1"
        android:text="@string/montant_initial"
        android:textColor="@color/noir"
        android:textSize="28sp"
        android:paddingEnd="4dp"
        android:background="@android:drawable/edit_text"
        app:layout_constraintStart_toEndOf="@id/spDeviseSource"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/spDeviseSource"
        app:layout_constraintBottom_toBottomOf="@id/spDeviseSource" />

    <ImageButton
        android:id="@+id/btnInverser"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="6dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/inverser"
        android:padding="8dp"
        android:src="@android:drawable/ic_menu_revert"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/spDeviseSource" />

    <Spinner
        android:id="@+id/spDeviseCible"
        android:layout_width="100dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/btnInverser"
        app:layout_constraintTop_toTopOf="@id/btnInverser"
        app:layout_constraintBottom_toBottomOf="@id/btnInverser" />

    <TextView
        android:id="@+id/tvResultat"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical|end"
        android:maxLines="1"
        android:text="@string/resultat_initial"
        android:textColor="@color/noir"
        android:textSize="28sp"
        android:paddingEnd="4dp"
        android:background="@android:drawable/edit_text"
        app:layout_constraintStart_toEndOf="@id/spDeviseCible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/spDeviseCible"
        app:layout_constraintBottom_toBottomOf="@id/spDeviseCible" />

    <Button
        android:id="@+id/btnConvertir"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/blanc"
        android:text="@string/convertir"
        android:textColor="@color/turquoise_clavier"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/btnInverser"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TableLayout
        android:id="@+id/tableClavier"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:stretchColumns="*"
        app:layout_constraintTop_toBottomOf="@id/guideZone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TableRow
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center">

            <Button
                android:id="@+id/btn7"
                style="@style/ToucheClavier"
                android:text="@string/chiffre_7" />

            <Button
                android:id="@+id/btn8"
                style="@style/ToucheClavier"
                android:text="@string/chiffre_8" />

            <Button
                android:id="@+id/btn9"
                style="@style/ToucheClavier"
                android:text="@string/chiffre_9" />
        </TableRow>

        <TableRow
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center">

            <Button
                android:id="@+id/btn4"
                style="@style/ToucheClavier"
                android:text="@string/chiffre_4" />

            <Button
                android:id="@+id/btn5"
                style="@style/ToucheClavier"
                android:text="@string/chiffre_5" />

            <Button
                android:id="@+id/btn6"
                style="@style/ToucheClavier"
                android:text="@string/chiffre_6" />
        </TableRow>

        <TableRow
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center">

            <Button
                android:id="@+id/btn1"
                style="@style/ToucheClavier"
                android:text="@string/chiffre_1" />

            <Button
                android:id="@+id/btn2"
                style="@style/ToucheClavier"
                android:text="@string/chiffre_2" />

            <Button
                android:id="@+id/btn3"
                style="@style/ToucheClavier"
                android:text="@string/chiffre_3" />
        </TableRow>

        <TableRow
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center">

            <Button
                android:id="@+id/btnC"
                style="@style/ToucheClavierRouge"
                android:text="@string/effacer" />

            <Button
                android:id="@+id/btn0"
                style="@style/ToucheClavier"
                android:text="@string/chiffre_0" />

            <Button
                android:id="@+id/btnPoint"
                style="@style/ToucheClavier"
                android:text="@string/point" />
        </TableRow>

    </TableLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
